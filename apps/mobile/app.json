{
  "expo": {
    "name": "MiniLedger",
    "slug": "miniledger",
    "scheme": "miniledger",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.miniledger.app",
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ]
  }
}
